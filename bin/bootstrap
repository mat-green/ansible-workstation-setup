#!/bin/sh
# if [ -z "$PROFILE" ]; then
#   echo "PROFILE environment variable not set, please set it to the profile you want to use (e.g. export PROFILE=work)"
#   exit 1
# fi

# if [ -z "$GIT_USER_NAME" ]; then
#   echo "GIT_USER_NAME environment variable not set, please set it to your git user name (e.g. export GIT_USER_NAME='John Doe')"
#   exit 2
# fi

# if [ -z "$GIT_USER_EMAIL" ]; then
#   echo "GIT_USER_EMAIL environment variable not set, please set it to your git user email (e.g. export GIT_USER_EMAIL='jane.doe@example.com')"
#   exit 3;
# fi

check=$((xcode-\select --install) 2>&1)
str="xcode-select: note: install requested for command line developer tools"
while [[ "$check" == "$str" ]];
do
  osascript -e 'tell app "System Events" to display dialog "xcode command-line tools missing." buttons "OK" default button 1 with title "xcode command-line tools"'
  exit;
done

if [ ! -d ansible ]; then
  # on only do this on apple silicon
  # /usr/sbin/softwareupdate --install-rosetta
  git config --global http.postBuffer 524288000
  # curl https://bootstrap.pypa.io/get-pip.py -o get-pip.py
  # python3 get-pip.py
  python3 -m venv ansible  # Create a virtualenv if one does not already exist
  source ansible/bin/activate   # Activate the virtual environment
  python3 -m pip install --upgrade pip
  pip3 install ansible
  #sudo pip3 install --ignore-installed ansible
else
  source ansible/bin/activate   # Activate the virtual environment
fi
ansible-galaxy role install -r requirements.yml
ansible-galaxy collection install -r requirements.yml

source ./bin/apply
